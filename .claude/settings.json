{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "python scripts/hooks/protect_specs.py"
          },
          {
            "type": "command",
            "command": "python scripts/hooks/no_direct_time.py"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python scripts/hooks/run_verify.py",
            "timeout": 600
          }
        ]
      }
    ]
  }
}
