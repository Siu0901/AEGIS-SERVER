# AEGIS 환경변수 견본
#
#   cp .env.example .env      (PowerShell: Copy-Item .env.example .env)
#
# `.env` 는 커밋하지 않는다(.gitignore). 이 견본만 레포에 남는다.
#
# 이 파일 하나를 `docker-compose.yml` · 서버 · REC 이 함께 읽는다.
# compose 는 `${VAR}` 치환으로, 파이썬 쪽은 pydantic-settings 의 `env_file=".env"` 로
# 같은 값을 본다. 두 곳에 값을 따로 적어두면 반드시 어긋나므로 여기만 고친다.
#
# **접두사를 쓰지 않는다.** API명세서 §4.7 이 `RECORDER_BASE` · `REC_RETENTION_DAYS` 를
# 그 이름 그대로 환경변수로 지정하고 있어, 나머지도 같은 규칙으로 맞췄다.
# (M0 의 `AEGIS_DATABASE_URL` 도 계속 인식한다 — server/infra/db/session.py 참고)

# ---------------------------------------------------------------------------
# 데이터베이스 · 캐시 · 브로커
# ---------------------------------------------------------------------------
# compose 의 postgres 서비스와 아래 DATABASE_URL 은 같은 자격증명을 가리켜야 한다.
POSTGRES_USER=aegis
POSTGRES_PASSWORD=aegis
POSTGRES_DB=aegis
POSTGRES_PORT=5432

DATABASE_URL=postgresql+psycopg://aegis:aegis@localhost:5432/aegis

REDIS_URL=redis://localhost:6379/0
REDIS_PORT=6379

MQTT_HOST=localhost
MQTT_PORT=1883

# ---------------------------------------------------------------------------
# 미디어 (서버 쪽)
# ---------------------------------------------------------------------------
# MEDIA_ROOT 는 **서버 노트북**의 영구 보관소다 — 이벤트 클립 · 키프레임.
# 7일 원본 녹화는 여기가 아니라 REC 이 REC_MEDIA_ROOT 에 쌓는다(기능명세서 §4.4).
MEDIA_ROOT=./media

# 카메라 RTSP. `uv run tasks.py cams` 가 여기로 송출하고, 서버·REC 이 여기서 읽는다.
#   {RTSP_BASE}/cam1/main   1920x1080 15fps  H.264 2.5Mbps  — 서버(라이브) · REC(녹화)
#   {RTSP_BASE}/cam1/sub      640x360 15fps  H.264          — 엣지(추론)
RTSP_BASE=rtsp://localhost:8554

# mediamtx 제어 API. 서버가 폴링해 메인 스트림 연결 상태를 관측한다(FN-SYS-01).
MEDIAMTX_API=http://localhost:9997

# 브라우저가 라이브 영상을 받는 곳. WebRTC(WHEP) 우선, 실패 시 HLS 폴백(FN-REC-01).
MEDIAMTX_WHEP=http://localhost:8889
MEDIAMTX_HLS=http://localhost:8888

# ---------------------------------------------------------------------------
# REC — 녹화 컴포넌트 (API명세서 §4.7)
# ---------------------------------------------------------------------------
# REC 은 독립 컴포넌트다. 개발 중에는 서버와 같은 기계에서 돌지만 M9 에 젯슨 SSD 로
# 옮긴다. **서버는 녹화 파일에 파일 경로로 접근하지 않고 항상 HTTP 로만 통신한다.**
# 옮길 때 고치는 값은 RECORDER_BASE 하나뿐이어야 한다.
RECORDER_BASE=http://localhost:9100

# REC 프로세스가 바인딩하는 곳. RECORDER_BASE 와 가리키는 대상이 같아야 한다.
REC_BIND_HOST=127.0.0.1
REC_BIND_PORT=9100

# 녹화 원본이 쌓이는 곳. 운용 시 엣지 NVMe SSD 마운트 지점으로 바꾼다.
#   {REC_MEDIA_ROOT}/{cam_id}/{YYYY-MM-DD}/{HH-MM-SS}.mp4
REC_MEDIA_ROOT=./media/rec

# 녹화 대상 카메라. 메인 스트림만 녹화한다(서브는 추론 전용).
REC_CAM_IDS=1,2

# 세그먼트 길이(초). API명세서 §4.7 녹화 규격 = 10초.
REC_SEGMENT_SECONDS=10

# 보존 기간(일). 기능명세서 §4.4 링버퍼 = 7일.
# 보존 정책 확인용으로 짧게 줄여볼 때는 소수도 받는다(예: 0.002 = 약 3분).
REC_RETENTION_DAYS=7

# 용량 상한(GB). 초과하면 보존 기간 이내라도 오래된 세그먼트부터 지운다(FN-REC-05).
# 운용(젯슨 500GB SSD)에서는 450 정도, 개발 노트북에서는 50 을 기본으로 둔다.
REC_MAX_DISK_GB=50

# 보존 정책 점검 주기(초).
REC_SWEEP_SECONDS=30

# ---------------------------------------------------------------------------
# 시각 동기화 (FN-SYS-02)
# ---------------------------------------------------------------------------
# 서버 기동 시 이 NTP 서버와의 오프셋을 재서 로깅한다. 클립 구간 정합의 전제다.
NTP_SERVER=pool.ntp.org
# 이 값(ms)을 넘으면 경고 로그를 남긴다.
NTP_WARN_OFFSET_MS=100
