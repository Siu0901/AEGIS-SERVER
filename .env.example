# AEGIS 환경변수 견본
#
#   cp .env.example .env      (PowerShell: Copy-Item .env.example .env)
#
# `.env` 는 커밋하지 않는다(.gitignore). 이 견본만 레포에 남는다.
#
# 이 파일 하나를 `docker-compose.yml` · 서버 · REC 이 함께 읽는다.
# compose 는 `${VAR}` 치환으로, 파이썬 쪽은 pydantic-settings 의 `env_file=".env"` 로
# 같은 값을 본다. 두 곳에 값을 따로 적어두면 반드시 어긋나므로 여기만 고친다.
#
# **주소는 `localhost` 대신 `127.0.0.1` 로 적는다.**
# Windows 에서 `localhost` 는 IPv6(::1)로 먼저 풀리는데, 루프백에만 바인딩하는
# 프로세스(REC · vite)는 127.0.0.1 로만 듣는다. 그러면 프로세스는 멀쩡히 떠 있는데
# 연결만 거부되고, 화면에는 '그 구성요소가 죽음'으로 보인다.
#
# **접두사를 쓰지 않는다.** API명세서 §4.7 이 `RECORDER_BASE` · `REC_RETENTION_DAYS` 를
# 그 이름 그대로 환경변수로 지정하고 있어, 나머지도 같은 규칙으로 맞췄다.
# (M0 의 `AEGIS_DATABASE_URL` 도 계속 인식한다 — server/infra/db/session.py 참고)

# ---------------------------------------------------------------------------
# 데이터베이스 · 캐시 · 브로커
# ---------------------------------------------------------------------------
# compose 의 postgres 서비스와 아래 DATABASE_URL 은 같은 자격증명·같은 포트를 가리켜야 한다.
#
# 기본 5432 를 쓰지 않는 이유: 기계에 PostgreSQL 이 따로 설치돼 있으면 그쪽이 5432 를
# 선점하고, Docker 포트 포워딩보다 먼저 응답한다. 그러면 컨테이너는 멀쩡한데
# "password authentication failed" 만 나와 원인을 찾기 어렵다.
POSTGRES_USER=aegis
POSTGRES_PASSWORD=aegis
POSTGRES_DB=aegis
POSTGRES_PORT=5433

DATABASE_URL=postgresql+psycopg://aegis:aegis@127.0.0.1:5433/aegis

REDIS_URL=redis://127.0.0.1:6379/0
REDIS_PORT=6379

# MQTT — 서버가 `aegis/alert` 를 발행하고 `aegis/device/status` 를 구독한다(API §3).
# **`localhost` 를 쓰지 않는다** — Windows 에서 `::1` 로 먼저 풀려 연결마다 IPv6
# 타임아웃을 먹는다(M2 에서 좌표 지연 2.8초의 원인이었다).
MQTT_HOST=127.0.0.1
MQTT_PORT=1883

# ---------------------------------------------------------------------------
# 경고 (FN-ALM-01 · 02)
# ---------------------------------------------------------------------------
# 사전 녹음 wav 가 사는 곳. **파일명 매핑은 여기가 아니라 DB(`alert_sounds`)에 있다**
# (절대규칙 6 · FN-CFG-03). `uv run tasks.py migrate` 가 매핑을 시드하고, 파일이 없으면
# 무음 wav 를 깔아 경로를 맞춘다 — 실제 녹음은 사람이 덮어쓴다.
AUDIO_DIR=./assets/audio

# 재생 백엔드: auto(기본) · winsound(Windows) · ffplay/aplay/paplay(리눅스·젯슨) · none.
# **`none` 은 명시적으로만 고른다.** 사운드 장치가 없어 조용해지는 것은 설정으로
# 선언해야 하는 사실이지 서버가 알아서 판단할 일이 아니다(절대규칙 9).
AUDIO_BACKEND=auto

# §3 `AlertCommand.duration_s` — 경광등·부저 지속 시간(초).
# ⚠ 명세서 §4.5 정책 목록에 대응 키가 없어 서버 설정에 두었다(docs/INDEX.md 「명세서 확인 필요」).
ALERT_DURATION_S=5

# 장치 상태 보고가 이 시간 이상 끊기면 오프라인으로 본다(sim/mcu_sim 주기 10초 × 3).
MCU_STALE_AFTER_S=30

# 클립 예약 실행 = confirmed_at + clip_post_roll_s + 이 여유(초). 기능명세서 §4.4 가 2초로 정했다.
# ⚠ 이것도 §4.5 정책 목록에 없어 서버 설정이다.
CLIP_MARGIN_S=2.0

# ---------------------------------------------------------------------------
# 미디어 (서버 쪽)
# ---------------------------------------------------------------------------
# MEDIA_ROOT 는 **서버 노트북**의 영구 보관소다 — 이벤트 클립 · 키프레임.
# 7일 원본 녹화는 여기가 아니라 REC 이 REC_MEDIA_ROOT 에 쌓는다(기능명세서 §4.4).
MEDIA_ROOT=./media

# 카메라 RTSP. `uv run tasks.py cams` 가 여기로 송출하고, 서버·REC 이 여기서 읽는다.
#   {RTSP_BASE}/cam1/main   1920x1080 15fps  H.264 2.5Mbps  — 서버(라이브) · REC(녹화)
#   {RTSP_BASE}/cam1/sub      640x360 15fps  H.264          — 엣지(추론)
RTSP_BASE=rtsp://127.0.0.1:8554

# mediamtx 제어 API. 서버가 폴링해 메인 스트림 연결 상태를 관측한다(FN-SYS-01).
MEDIAMTX_API=http://127.0.0.1:9997

# 브라우저가 라이브 영상을 받는 곳. WebRTC(WHEP) 우선, 실패 시 HLS 폴백(FN-REC-01).
MEDIAMTX_WHEP=http://127.0.0.1:8889
MEDIAMTX_HLS=http://127.0.0.1:8888

# ---------------------------------------------------------------------------
# REC — 녹화 컴포넌트 (API명세서 §4.7)
# ---------------------------------------------------------------------------
# REC 은 독립 컴포넌트다. 개발 중에는 서버와 같은 기계에서 돌지만 M9 에 젯슨 SSD 로
# 옮긴다. **서버는 녹화 파일에 파일 경로로 접근하지 않고 항상 HTTP 로만 통신한다.**
# 옮길 때 고치는 값은 RECORDER_BASE 하나뿐이어야 한다.
RECORDER_BASE=http://127.0.0.1:9100

# REC 프로세스가 바인딩하는 곳. RECORDER_BASE 와 가리키는 대상이 같아야 한다.
REC_BIND_HOST=127.0.0.1
REC_BIND_PORT=9100

# 녹화 원본이 쌓이는 곳. 운용 시 엣지 NVMe SSD 마운트 지점으로 바꾼다.
#   {REC_MEDIA_ROOT}/{cam_id}/{YYYY-MM-DD}/{HH-MM-SS}.mp4
REC_MEDIA_ROOT=./media/rec

# 녹화 대상 카메라. 메인 스트림만 녹화한다(서브는 추론 전용).
REC_CAM_IDS=1,2

# 세그먼트 길이(초). API명세서 §4.7 녹화 규격 = 10초.
REC_SEGMENT_SECONDS=10

# 보존 기간(일). **개발 = 1시간(0.0417) · 운용 = 7일.**
#
# 운용값 7일은 기능명세서 §4.4 링버퍼이며 젯슨 NVMe SSD 기준이다. 개발 노트북에는
# 녹화가 쌓일 이유가 없다 — 2채널 실측 1.95 GB/시간이라 하루만 켜둬도 47GB 가 차고,
# 그건 검증에 아무 도움이 되지 않는다. 보존 스윕이 실제로 도는 것을 보는 데는
# 1시간이면 충분하다.
#
# 소수를 받는다(예: 0.002 = 약 3분). 운용으로 올릴 때 고치는 값은 여기 하나다.
REC_RETENTION_DAYS=0.0417

# 용량 상한(GB). 초과하면 보존 기간 이내라도 오래된 세그먼트부터 지운다(FN-REC-05).
# 운용(젯슨 500GB SSD)에서는 450 정도, 개발 노트북에서는 50 을 기본으로 둔다.
REC_MAX_DISK_GB=50

# 보존 정책 점검 주기(초).
REC_SWEEP_SECONDS=30

# ---------------------------------------------------------------------------
# 시각 동기화 (FN-SYS-02)
# ---------------------------------------------------------------------------
# 서버 기동 시 이 NTP 서버와의 오프셋을 재서 로깅한다. 클립 구간 정합의 전제다.
NTP_SERVER=pool.ntp.org
# 이 값(ms)을 넘으면 경고 로그를 남긴다.
NTP_WARN_OFFSET_MS=100

# ---------------------------------------------------------------------------
# 클라우드 (Tier 2 · FN-AI · FN-SYS-03)
# ---------------------------------------------------------------------------
# ★ **비워 두면 지능 기능만 꺼진 채로 기동한다.** 감지 → 확정 → 경고 → 시정 루프는
#   클라우드를 부르지 않으므로 인터넷 없는 현장이 정상 운용 조건이다. 키가 없다고
#   서버가 뜨지 않으면 그건 격리의 반대다.
#
#   켜지는 것: LLM 심층 분석(FN-AI-05) · 유사 사례(07) · 자유 문장 장면 검색(02) ·
#             현장 브리핑(09) · 이상 탐지(04) · 보고서 서술(10)
#   키가 없어도 도는 것: 규정 매핑(06) · SQL 통계 · 조건 검색
#
# **실제 키를 이 파일에 적지 마라.** 여기는 git 에 올라간다 — `.env` 에만 적는다.
GEMINI_API_KEY=
# 임베딩 모델. 출력 차원이 halfvec(3072) 과 맞아야 한다.
GEMINI_EMBED_MODEL=gemini-embedding-001
# 심층 분석·챗봇·브리핑·보고서에 쓰는 생성 모델.
GEMINI_TEXT_MODEL=gemini-flash-latest
